{
  "name": "arjun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc -p tsconfig.json && npm --prefix web run build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix web run typecheck",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
