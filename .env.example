# Login for the web UI (one shared account)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# Long random string, e.g. from: openssl rand -hex 32
SESSION_SECRET=

# Port on your machine for local docker compose (Coolify ignores this)
HOST_PORT=3000

# Slack (optional). Leave empty to keep Slack off. See "Slack" in the README.
SLACK_USER_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated Slack user IDs who may talk to Arjun. Empty means every full member of the workspace.
SLACK_ALLOWED_USERS=
